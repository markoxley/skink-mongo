// File:    bson_test.skink
// Purpose: Unit tests for mongo_bson — exact wire encoding, decoder
//          round-trips for every supported element kind, nested docs,
//          lookups, and malformed-input handling.
module bson_test

import "mongo_bson"
import "std/str"
import "std/libc"
import "std/testing"

// TestEncodeScalars verifies byte-exact BSON for scalars.
pub fn TestEncodeScalars() {
    doc := mongo_bson.Doc(
        []string{"i32", "i64", "s", "b", "n"},
        []mongo_bson.Val{
            mongo_bson.VInt(int64(42)),
            mongo_bson.VLong(int64(5000000000)),
            mongo_bson.VStr("hi"),
            mongo_bson.VBool(true),
            mongo_bson.VNull(),
        })
    data, n := mongo_bson.Encode(doc)
    // hand-computed layout
    r := mongo_bson.NewReader(data, n)
    testing.AssertEqualInt(n, mongo_bson.RI32(&r), "doc length")
    testing.AssertEqualInt(mongo_bson.E_INT32, int(data[r.Pos]), "i32 tag")
    r.Pos = r.Pos + 1
    testing.AssertEqualString("i32", mongo_bson.RCStr(&r), "i32 key")
    testing.AssertEqualInt(42, mongo_bson.RI32(&r), "i32 value")
    testing.AssertEqualInt(mongo_bson.E_INT64, int(data[r.Pos]), "i64 tag")
    r.Pos = r.Pos + 1
    testing.AssertEqualString("i64", mongo_bson.RCStr(&r), "i64 key")
    testing.AssertTrue(mongo_bson.RI64(&r) == int64(5000000000), "i64 value")
    testing.AssertEqualInt(mongo_bson.E_STRING, int(data[r.Pos]), "str tag")
    r.Pos = r.Pos + 1
    mongo_bson.RCStr(&r)
    slen := mongo_bson.RI32(&r)
    testing.AssertEqualInt(3, slen, "str len incl NUL")
    s, _ := mongo_bson.RBytes(&r, 2)
    testing.AssertEqualString("hi", s, "str value")
    testing.AssertEqualInt(0, int(data[r.Pos]), "str NUL")
    r.Pos = r.Pos + 1
    testing.AssertEqualInt(mongo_bson.E_BOOL, int(data[r.Pos]), "bool tag")
    r.Pos = r.Pos + 1
    mongo_bson.RCStr(&r)
    testing.AssertEqualInt(1, int(data[r.Pos]), "bool true")
    r.Pos = r.Pos + 1
    testing.AssertEqualInt(mongo_bson.E_NULL, int(data[r.Pos]), "null tag")
    libc.free(data)
}

// TestRoundTrip encodes a mixed doc and decodes it back.
pub fn TestRoundTrip() {
    inner := mongo_bson.Doc([]string{"x"}, []mongo_bson.Val{mongo_bson.VInt(int64(7))})
    arr := mongo_bson.Arr([]mongo_bson.Val{
        mongo_bson.VStr("a"), mongo_bson.VInt(int64(2))})
    bin := libc.malloc(4)
    bin[0] = 1
    bin[1] = 0
    bin[2] = 255
    bin[3] = 0
    doc := mongo_bson.Doc(
        []string{"d", "arr", "bin", "oid", "dt", "f"},
        []mongo_bson.Val{
            inner, arr,
            mongo_bson.VBinary(bin, 4, 0),
            mongo_bson.VObjectId("0123456789ab"),
            mongo_bson.VDatetime(int64(1709258400123)),
            mongo_bson.VDouble(3.5),
        })
    data, n := mongo_bson.Encode(doc)
    r := mongo_bson.NewReader(data, n)
    out, err := mongo_bson.Decode(&r)
    testing.AssertTrue(str.Len(err.message) == 0, "decode")
    testing.AssertEqualInt(6, len(out.Keys), "field count")
    testing.AssertEqualString("d", out.Keys[0], "key order")

    d, _ := mongo_bson.Get(out, "d")
    x, _ := mongo_bson.Get(d, "x")
    testing.AssertTrue(x.I64 == int64(7), "nested int")

    a, _ := mongo_bson.Get(out, "arr")
    testing.AssertEqualInt(2, len(a.Arr), "array len")
    testing.AssertEqualString("a", a.Arr[0].Str, "arr[0]")
    testing.AssertTrue(a.Arr[1].I64 == int64(2), "arr[1]")

    b, _ := mongo_bson.Get(out, "bin")
    testing.AssertEqualInt(4, b.Len, "bin len")
    testing.AssertEqualInt(0, b.Bytes[1], "bin NUL preserved")
    testing.AssertEqualInt(255, b.Bytes[2] & 255, "bin byte")

    o, _ := mongo_bson.Get(out, "oid")
    testing.AssertEqualInt(12, o.Len, "oid len")

    dt, _ := mongo_bson.Get(out, "dt")
    testing.AssertTrue(dt.I64 == int64(1709258400123), "datetime ms")

    f, _ := mongo_bson.Get(out, "f")
    testing.AssertEqualFloat(3.5, f.Num, "double")
    libc.free(data)
}

// TestPath covers dotted-path lookup.
pub fn TestPath() {
    fb := mongo_bson.Arr([]mongo_bson.Val{
        mongo_bson.Doc([]string{"name"}, []mongo_bson.Val{mongo_bson.VStr("x")})})
    cur := mongo_bson.Doc([]string{"id", "firstBatch"},
        []mongo_bson.Val{mongo_bson.VLong(int64(0)), fb})
    rep := mongo_bson.Doc([]string{"cursor", "ok"},
        []mongo_bson.Val{cur, mongo_bson.VDouble(1.0)})
    v, ok := mongo_bson.Path(rep, "cursor.firstBatch")
    testing.AssertTrue(ok, "path found")
    testing.AssertEqualInt(1, len(v.Arr), "batch len")
    testing.AssertTrue(mongo_bson.OkField(rep), "ok field")
    _, missing := mongo_bson.Path(rep, "cursor.nope")
    testing.AssertFalse(missing, "missing path")
}

// TestMalformed covers truncated/oversized docs failing cleanly.
pub fn TestMalformed() {
    bad := libc.malloc(4)
    bad[0] = 99
    bad[1] = 0
    bad[2] = 0
    bad[3] = 0
    r := mongo_bson.NewReader(bad, 4)
    _, err := mongo_bson.Decode(&r)
    testing.AssertTrue(str.Len(err.message) > 0, "short doc rejected")
    libc.free(bad)
}
