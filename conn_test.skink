// File:    conn_test.skink
// Purpose: Integration tests for mongo_conn — hello handshake,
//          real SCRAM-SHA-256 auth (verified cryptographically by the
//          testkit's server-side implementation), find+cursors,
//          insert/update/delete, and error-doc mapping.
module conn_test

import "mongo_bson"
import "mongo_conn"
import "testkit"
import "mod/markoxley/skink-dbx/dbx_dsn"
import "std/str"
import "std/libc"
import "std/testing"
import "std/waitgroup"
import "std/errors"

var lastCmd string
var lastDoc mongo_bson.Val

// first returns the command name (first key) of a request doc.
fn firstKey(doc: mongo_bson.Val) -> string {
    if len(doc.Keys) == 0 {
        return ""
    }
    return doc.Keys[0]
}

// okReply builds {ok: 1} plus the given extra fields.
fn okReply(keys: []string, vals: []mongo_bson.Val) -> testkit.Reply {
    return testkit.Reply{Doc: mongo_bson.Doc(append(keys, "ok"),
        append(vals, mongo_bson.VDouble(1.0)))}
}

// TestConnectHello covers the handshake: hello → reply captures server
// metadata; no auth when the DSN has no user.
pub fn TestConnectHello() {
    fs, wg, serr := testkit.StartFakeServer(15701)
    testing.AssertTrue(str.Len(serr.message) == 0, "fake server")
    spawn testkit.Serve(&fs, 2, helloResponder, wg)

    info, _ := dbx_dsn.ParseDSN("mongodb://127.0.0.1:15701/app")
    c, cerr := mongo_conn.Connect(info)
    testing.AssertTrue(str.Len(cerr.message) == 0, str.Concat("connect: ", cerr.message))
    testing.AssertEqualString("7.0.0-fake", c.ServerVer, "server version")
    testing.AssertEqualInt(17, c.MaxWire, "wire version")
    testing.AssertEqualString("hello", firstKey(lastDoc), "hello sent first")
    mongo_conn.Close(&c)
    waitgroup.Wait(wg)
}

fn helloResponder(doc: mongo_bson.Val) -> testkit.Reply {
    lastDoc = doc
    return okReply([]string{"maxWireVersion", "version"},
        []mongo_bson.Val{mongo_bson.VInt(int64(17)), mongo_bson.VStr("7.0.0-fake")})
}

// TestScramAuth runs a real SCRAM-SHA-256 exchange — the testkit
// verifies the client proof with actual PBKDF2/HMAC math.
pub fn TestScramAuth() {
    testkit.EnableScram("alice", "wonderland", "testsalt0123456789", 4096)
    fs, wg, serr := testkit.StartFakeServer(15702)
    testing.AssertTrue(str.Len(serr.message) == 0, "fake server")
    // 1 hello + 2 sasl rounds + 1 ping
    spawn testkit.Serve(&fs, 4, helloResponder, wg)

    info, _ := dbx_dsn.ParseDSN(
        "mongodb://alice:wonderland@127.0.0.1:15702/app?authMechanism=SCRAM-SHA-256")
    c, cerr := mongo_conn.Connect(info)
    testing.AssertTrue(str.Len(cerr.message) == 0, str.Concat("auth: ", cerr.message))
    testing.AssertTrue(c.Authed, "authed flag")
    perr := mongo_conn.Ping(&c)
    testing.AssertTrue(str.Len(perr.message) == 0, "ping")
    mongo_conn.Close(&c)
    waitgroup.Wait(wg)
    testkit.EnableScram("", "", "", 0) // disarm for later tests
}

// TestScramBadPassword confirms a wrong password is rejected by the
// fake's real signature check (and surfaces as an auth error).
pub fn TestScramBadPassword() {
    testkit.EnableScram("alice", "wonderland", "testsalt0123456789", 4096)
    fs, wg, _ := testkit.StartFakeServer(15703)
    spawn testkit.Serve(&fs, 6, helloResponder, wg)
    info, _ := dbx_dsn.ParseDSN(
        "mongodb://alice:wrongpw@127.0.0.1:15703/app?authMechanism=SCRAM-SHA-256")
    _, cerr := mongo_conn.Connect(info)
    testing.AssertTrue(str.Len(cerr.message) > 0, "bad password must fail")
    waitgroup.Wait(wg)
    testkit.EnableScram("", "", "", 0)
}

// findResponder answers find/getMore with a two-batch cursor.
var findCalls = 0
fn findResponder(doc: mongo_bson.Val) -> testkit.Reply {
    lastDoc = doc
    name := firstKey(doc)
    if str.Equal(name, "find") {
        findCalls = findCalls + 1
        batch := mongo_bson.Arr([]mongo_bson.Val{
            mongo_bson.Doc([]string{"_id", "n"},
                []mongo_bson.Val{mongo_bson.VInt(int64(1)), mongo_bson.VStr("a")}),
            mongo_bson.Doc([]string{"_id", "n"},
                []mongo_bson.Val{mongo_bson.VInt(int64(2)), mongo_bson.VStr("b")}),
        })
        cur := mongo_bson.Doc([]string{"id", "firstBatch"},
            []mongo_bson.Val{mongo_bson.VLong(int64(777)), batch})
        return okReply([]string{"cursor"}, []mongo_bson.Val{cur})
    }
    if str.Equal(name, "getMore") {
        batch := mongo_bson.Arr([]mongo_bson.Val{
            mongo_bson.Doc([]string{"_id", "n"},
                []mongo_bson.Val{mongo_bson.VInt(int64(3)), mongo_bson.VStr("c")}),
        })
        cur := mongo_bson.Doc([]string{"id", "nextBatch"},
            []mongo_bson.Val{mongo_bson.VLong(int64(0)), batch})
        return okReply([]string{"cursor"}, []mongo_bson.Val{cur})
    }
    return okReply([]string{}, []mongo_bson.Val{})
}

// TestFindCursor iterates a two-batch cursor over find+getMore.
pub fn TestFindCursor() {
    findCalls = 0
    fs, wg, _ := testkit.StartFakeServer(15704)
    // hello + find + getMore = 3 turns
    spawn testkit.Serve(&fs, 3, findResponder, wg)
    info, _ := dbx_dsn.ParseDSN("mongodb://127.0.0.1:15704/app")
    c, _ := mongo_conn.Connect(info)
    cur, ferr := mongo_conn.Find(&c, "items",
        mongo_bson.Doc([]string{"kind"}, []mongo_bson.Val{mongo_bson.VStr("x")}))
    testing.AssertTrue(str.Len(ferr.message) == 0, "find")
    total := 0
    for mongo_conn.Next(&cur) {
        d := mongo_conn.Doc(&cur)
        v, _ := mongo_bson.Get(d, "n")
        testing.AssertTrue(v.Kind == mongo_bson.E_STRING, "doc field type")
        total = total + 1
    }
    testing.AssertEqualInt(3, total, "all docs iterated")
    mongo_conn.Close(&c)
    waitgroup.Wait(wg)
}

// TestInsertUpdateDelete covers the write commands.
pub fn TestInsertUpdateDelete() {
    fs, wg, _ := testkit.StartFakeServer(15705)
    spawn testkit.Serve(&fs, 4, writeResponder, wg)
    info, _ := dbx_dsn.ParseDSN("mongodb://127.0.0.1:15705/app")
    c, _ := mongo_conn.Connect(info)

    n, ierr := mongo_conn.Insert(&c, "t", []mongo_bson.Val{
        mongo_bson.Doc([]string{"a"}, []mongo_bson.Val{mongo_bson.VInt(int64(1))}),
        mongo_bson.Doc([]string{"a"}, []mongo_bson.Val{mongo_bson.VInt(int64(2))}),
    })
    testing.AssertTrue(str.Len(ierr.message) == 0, "insert")
    testing.AssertTrue(n == int64(2), "insert count")

    upd := mongo_bson.Doc([]string{"q", "u", "multi"},
        []mongo_bson.Val{
            mongo_bson.Doc([]string{"a"}, []mongo_bson.Val{mongo_bson.VInt(int64(1))}),
            mongo_bson.Doc([]string{"$set"}, []mongo_bson.Val{
                mongo_bson.Doc([]string{"b"}, []mongo_bson.Val{mongo_bson.VInt(int64(9))})}),
            mongo_bson.VBool(true),
        })
    n, uerr := mongo_conn.Update(&c, "t", []mongo_bson.Val{upd})
    testing.AssertTrue(str.Len(uerr.message) == 0, "update")
    testing.AssertTrue(n == int64(2), "update count")

    del := mongo_bson.Doc([]string{"q", "limit"},
        []mongo_bson.Val{
            mongo_bson.Doc([]string{"a"}, []mongo_bson.Val{mongo_bson.VInt(int64(1))}),
            mongo_bson.VInt(int64(1)),
        })
    n, derr := mongo_conn.Delete(&c, "t", []mongo_bson.Val{del})
    testing.AssertTrue(str.Len(derr.message) == 0, "delete")
    testing.AssertTrue(n == int64(1), "delete count")
    mongo_conn.Close(&c)
    waitgroup.Wait(wg)
}

fn writeResponder(doc: mongo_bson.Val) -> testkit.Reply {
    name := firstKey(doc)
    if str.Equal(name, "hello") || str.Equal(name, "ismaster") {
        return helloResponder(doc)
    }
    if str.Equal(name, "insert") {
        return okReply([]string{"n"}, []mongo_bson.Val{mongo_bson.VInt(int64(2))})
    }
    if str.Equal(name, "update") {
        return okReply([]string{"n"}, []mongo_bson.Val{mongo_bson.VInt(int64(2))})
    }
    if str.Equal(name, "delete") {
        return okReply([]string{"n"}, []mongo_bson.Val{mongo_bson.VInt(int64(1))})
    }
    return okReply([]string{}, []mongo_bson.Val{})
}

// TestErrorReply maps {ok:0, errmsg} to an error.
pub fn TestErrorReply() {
    fs, wg, _ := testkit.StartFakeServer(15706)
    spawn testkit.Serve(&fs, 2, errResponder, wg)
    info, _ := dbx_dsn.ParseDSN("mongodb://127.0.0.1:15706/app")
    c, _ := mongo_conn.Connect(info)
    _, err := mongo_conn.RunCommand(&c, c.Db, mongo_bson.Doc(
        []string{"bogus"}, []mongo_bson.Val{mongo_bson.VInt(int64(1))}))
    testing.AssertTrue(str.Len(err.message) > 0, "error surfaces")
    testing.AssertContains(err.message, "no such command", "errmsg propagated")
    mongo_conn.Close(&c)
    waitgroup.Wait(wg)
}

fn errResponder(doc: mongo_bson.Val) -> testkit.Reply {
    name := firstKey(doc)
    if str.Equal(name, "hello") || str.Equal(name, "ismaster") {
        return helloResponder(doc)
    }
    return testkit.Reply{Err: "no such command: bogus"}
}

// TestCursorDocGuard — regression: Doc() on an exhausted/empty cursor
// must return an empty Val instead of panicking on the batch index.
pub fn TestCursorDocGuard() {
    cur := mongo_conn.Cursor{}
    v := mongo_conn.Doc(&cur)
    testing.AssertTrue(v.Kind != mongo_bson.E_DOC, "empty doc")
}
