// File:    mongo_bson.skink
// Purpose: BSON codec for the MongoDB wire protocol. `Val` is a tagged
//          value covering every BSON element type; documents are
//          Val{Kind: E_DOC} with parallel Keys/Arr arrays preserving
//          field order (MongoDB command keys are order-sensitive —
//          the command name must be the first element).
//
//          All payload handling is length-explicit: BSON is riddled
//          with NUL bytes, so Skink strings here are (ptr,len) pairs —
//          never measure them with str.Len.
module mongo_bson

import "std/str"
import "std/libc"
import "std/errors"

// Raw byte accessors for binary wire/test buffers — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte.
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)


// BSON element type bytes.
pub const E_DOUBLE    = 0x01
pub const E_STRING    = 0x02
pub const E_DOC       = 0x03
pub const E_ARRAY     = 0x04
pub const E_BINARY    = 0x05
pub const E_OBJECTID  = 0x07
pub const E_BOOL      = 0x08
pub const E_DATETIME  = 0x09 // int64 ms since epoch
pub const E_NULL      = 0x0A
pub const E_REGEX     = 0x0B
pub const E_INT32     = 0x10
pub const E_TIMESTAMP = 0x11 // internal; decoded as I64
pub const E_INT64     = 0x12
pub const E_DECIMAL   = 0x13 // decimal128; decoded as Bytes(16)
pub const E_MINKEY    = 0xFF
pub const E_MAXKEY    = 0x7F

// Val is one BSON value. Which fields are live depends on Kind:
//   E_DOUBLE    → Num
//   E_INT32/E_INT64/E_DATETIME/E_TIMESTAMP → I64
//   E_STRING    → Str (NUL-free by spec)
//   E_BINARY    → Bytes[0..Len), Subtype
//   E_OBJECTID  → Bytes[0..12)
//   E_DECIMAL   → Bytes[0..16)
//   E_BOOL      → Bool
//   E_DOC/E_ARRAY → Keys + Arr (Keys empty for arrays)
//   E_REGEX     → Str (pattern) + Options
pub struct Val {
    Kind:    int
    Num:     float
    I64:     int64
    Str:     string
    Bytes:   string
    Len:     int
    Subtype: int
    Options: string
    Bool:    bool
    Keys:    []string
    Arr:     []Val
}

// ---- constructors -----------------------------------------------------------

// Doc builds a document from parallel key/value slices.
pub fn Doc(keys: []string, vals: []Val) -> Val {
    return Val{Kind: E_DOC, Keys: keys, Arr: vals}
}

// Arr builds a BSON array (numeric string keys are synthesized on encode).
pub fn Arr(vals: []Val) -> Val {
    return Val{Kind: E_ARRAY, Arr: vals}
}

// VInt encodes as int32 when it fits, else int64.
pub fn VInt(v: int64) -> Val {
    if v >= int64(-2147483648) && v <= int64(2147483647) {
        return Val{Kind: E_INT32, I64: v}
    }
    return Val{Kind: E_INT64, I64: v}
}

// VLong forces an int64 encoding.
pub fn VLong(v: int64) -> Val {
    return Val{Kind: E_INT64, I64: v}
}

// VDouble encodes a double.
pub fn VDouble(v: float) -> Val {
    return Val{Kind: E_DOUBLE, Num: v}
}

// VStr encodes a UTF-8 string.
pub fn VStr(s: string) -> Val {
    return Val{Kind: E_STRING, Str: s}
}

// VBool encodes a boolean.
pub fn VBool(b: bool) -> Val {
    return Val{Kind: E_BOOL, Bool: b}
}

// VNull encodes null.
pub fn VNull() -> Val {
    return Val{Kind: E_NULL}
}

// VBinary encodes a binary payload (exactly n bytes) with a subtype.
pub fn VBinary(data: string, n: int, subtype: int) -> Val {
    return Val{Kind: E_BINARY, Bytes: data, Len: n, Subtype: subtype}
}

// VDatetime encodes Unix milliseconds as a BSON datetime.
pub fn VDatetime(ms: int64) -> Val {
    return Val{Kind: E_DATETIME, I64: ms}
}

// VObjectId encodes a 12-byte ObjectId.
pub fn VObjectId(bytes12: string) -> Val {
    return Val{Kind: E_OBJECTID, Bytes: bytes12, Len: 12}
}

// ---- OutBuf: explicit-length growable byte buffer ---------------------------

// OutBuf accumulates binary output. Separate from the dbx buffered
// connection — this is a pure encoder scratch space.
pub struct OutBuf {
    Buf: string
    Len: int
    Cap: int
}

// NewOutBuf allocates a buffer.
pub fn NewOutBuf(cap: int) -> OutBuf {
    if cap < 64 {
        cap = 64
    }
    return OutBuf{Buf: libc.malloc(cap), Len: 0, Cap: cap}
}

// Free releases the buffer.
pub fn Free(b: *OutBuf) {
    libc.free(b.Buf)
    b.Buf = ""
    b.Len = 0
    b.Cap = 0
}

// grow ensures n more bytes fit.
fn grow(b: *OutBuf, n: int) {
    if b.Len + n <= b.Cap {
        return
    }
    cap := b.Cap * 2
    for cap < b.Len + n {
        cap = cap * 2
    }
    nb := libc.malloc(cap)
    libc.memcpy(nb, b.Buf, b.Len)
    libc.free(b.Buf)
    b.Buf = nb
    b.Cap = cap
}

// Byte appends one byte.
pub fn Byte(b: *OutBuf, c: int) {
    grow(b, 1)
    Skink_mem_write_byte(b.Buf, int64(b.Len), c)
    b.Len = b.Len + 1
}

// WriteN appends exactly n bytes (may contain NULs).
pub fn WriteN(b: *OutBuf, s: string, n: int) {
    grow(b, n)
    libc.memcpy(string(int64(b.Buf) + int64(b.Len)), s, n)
    b.Len = b.Len + n
}

// I32/I64 append little-endian integers.
pub fn I32(b: *OutBuf, v: int) {
    grow(b, 4)
    Skink_mem_write_byte(b.Buf, int64(b.Len), v & 255)
    Skink_mem_write_byte(b.Buf, int64(b.Len + 1), (v >> 8) & 255)
    Skink_mem_write_byte(b.Buf, int64(b.Len + 2), (v >> 16) & 255)
    Skink_mem_write_byte(b.Buf, int64(b.Len + 3), (v >> 24) & 255)
    b.Len = b.Len + 4
}

pub fn I64(b: *OutBuf, v: int64) {
    grow(b, 8)
    for i := 0; i < 8; i = i + 1 {
        Skink_mem_write_byte(b.Buf, int64(b.Len + i), int((v >> (i * 8)) & int64(255)))
    }
    b.Len = b.Len + 8
}

// CStr appends a NUL-terminated string.
pub fn CStr(b: *OutBuf, s: string) {
    WriteN(b, s, str.Len(s))
    Byte(b, 0)
}

// PatchI32 overwrites 4 bytes at pos with a little-endian i32.
pub fn PatchI32(b: *OutBuf, pos: int, v: int) {
    Skink_mem_write_byte(b.Buf, int64(pos), v & 255)
    Skink_mem_write_byte(b.Buf, int64(pos + 1), (v >> 8) & 255)
    Skink_mem_write_byte(b.Buf, int64(pos + 2), (v >> 16) & 255)
    Skink_mem_write_byte(b.Buf, int64(pos + 3), (v >> 24) & 255)
}

// ---- encoding --------------------------------------------------------------

// encDoc appends the wire bytes of a document/array Val.
fn encDoc(b: *OutBuf, doc: Val) {
    start := b.Len
    I32(b, 0) // length placeholder
    for i := 0; i < len(doc.Arr); i = i + 1 {
        v := doc.Arr[i]
        Byte(b, v.Kind)
        if doc.Kind == E_DOC {
            CStr(b, doc.Keys[i])
        } else {
            CStr(b, Itoa64(int64(i)))
        }
        encPayload(b, v)
    }
    Byte(b, 0)
    PatchI32(b, start, b.Len - start)
}

// encPayload writes one element payload by kind.
fn encPayload(b: *OutBuf, v: Val) {
    if v.Kind == E_DOUBLE {
        var f float
        f = v.Num
        fp := libc.malloc(8)
        libc.memcpy(fp, &f, 8)
        WriteN(b, fp, 8)
        libc.free(fp)
        return
    }
    if v.Kind == E_STRING {
        n := str.Len(v.Str)
        I32(b, n + 1)
        WriteN(b, v.Str, n)
        Byte(b, 0)
        return
    }
    if v.Kind == E_DOC || v.Kind == E_ARRAY {
        encDoc(b, v)
        return
    }
    if v.Kind == E_BINARY {
        I32(b, v.Len)
        Byte(b, v.Subtype)
        WriteN(b, v.Bytes, v.Len)
        return
    }
    if v.Kind == E_OBJECTID {
        WriteN(b, v.Bytes, 12)
        return
    }
    if v.Kind == E_DECIMAL {
        WriteN(b, v.Bytes, 16)
        return
    }
    if v.Kind == E_BOOL {
        if v.Bool {
            Byte(b, 1)
        } else {
            Byte(b, 0)
        }
        return
    }
    if v.Kind == E_DATETIME || v.Kind == E_TIMESTAMP {
        I64(b, v.I64)
        return
    }
    if v.Kind == E_NULL || v.Kind == E_MINKEY || v.Kind == E_MAXKEY {
        return
    }
    if v.Kind == E_REGEX {
        CStr(b, v.Str)
        CStr(b, v.Options)
        return
    }
    if v.Kind == E_INT32 {
        I32(b, int(v.I64))
        return
    }
    if v.Kind == E_INT64 {
        I64(b, v.I64)
        return
    }
}

// Encode returns (ptr, len) wire bytes for a document Val. The caller
// owns the returned buffer (libc.malloc'd, NUL-terminated for safety).
pub fn Encode(doc: Val) -> (string, int) {
    b := NewOutBuf(256)
    encDoc(&b, doc)
    grow(&b, 1)
    Skink_mem_write_byte(b.Buf, int64(b.Len), 0)
    return b.Buf, b.Len
}

// ---- decoding ---------------------------------------------------------------

// Reader is a byte cursor over a BSON buffer.
pub struct Reader {
    Body: string
    Len:  int
    Pos:  int
}

// NewReader wraps a buffer.
pub fn NewReader(body: string, n: int) -> Reader {
    return Reader{Body: body, Len: n, Pos: 0}
}

// RI32/RI64 read little-endian integers.
pub fn RI32(r: *Reader) -> int {
    if r.Pos + 4 > r.Len {
        return 0
    }
    v := int(Skink_mem_byte(r.Body, int64(r.Pos))) | (int(Skink_mem_byte(r.Body, int64(r.Pos + 1))) << 8) |
        (int(Skink_mem_byte(r.Body, int64(r.Pos + 2))) << 16) | (int(Skink_mem_byte(r.Body, int64(r.Pos + 3))) << 24)
    r.Pos = r.Pos + 4
    return v
}

pub fn RI64(r: *Reader) -> int64 {
    lo := int64(RI32(r))
    hi := int64(RI32(r))
    return (hi << 32) | (lo & int64(4294967295))
}

// RBytes copies out n bytes.
pub fn RBytes(r: *Reader, n: int) -> (string, int) {
    if n < 0 || r.Pos + n > r.Len {
        n = r.Len - r.Pos
        if n < 0 {
            n = 0
        }
    }
    out := libc.malloc(n + 1)
    libc.memcpy(out, string(int64(r.Body) + int64(r.Pos)), n)
    Skink_mem_write_byte(out, int64(n), 0)
    r.Pos = r.Pos + n
    return out, n
}

// RCStr reads a NUL-terminated key (element names are ASCII cstrings).
pub fn RCStr(r: *Reader) -> string {
    start := r.Pos
    for r.Pos < r.Len && Skink_mem_byte(r.Body, int64(r.Pos)) != 0 {
        r.Pos = r.Pos + 1
    }
    n := r.Pos - start
    out := libc.malloc(n + 1)
    libc.memcpy(out, string(int64(r.Body) + int64(start)), n)
    Skink_mem_write_byte(out, int64(n), 0)
    if r.Pos < r.Len {
        r.Pos = r.Pos + 1
    }
    return out
}

// Decode parses one document starting at r.Pos and advances past it.
pub fn Decode(r: *Reader) -> (Val, errors.Error) {
    docLen := RI32(r)
    if docLen < 5 || r.Pos - 4 + docLen > r.Len {
        return Val{}, errors.New("bson: malformed document length")
    }
    end := r.Pos - 4 + docLen
    var keys []string
    var vals []Val
    for r.Pos < end {
        t := int(Skink_mem_byte(r.Body, int64(r.Pos)))
        r.Pos = r.Pos + 1
        if t == 0 {
            break
        }
        key := RCStr(r)
        v, derr := decodeElem(t, r)
        if str.Len(derr.message) > 0 {
            return Val{}, derr
        }
        keys = append(keys, key)
        vals = append(vals, v)
    }
    r.Pos = end
    return Val{Kind: E_DOC, Keys: keys, Arr: vals}, errors.New("")
}

// decodeElem reads the payload of one element of type t.
fn decodeElem(t: int, r: *Reader) -> (Val, errors.Error) {
    v := Val{Kind: t}
    if t == E_DOUBLE {
        var f float
        bits, _ := RBytes(r, 8)
        libc.memcpy(&f, bits, 8)
        v.Num = f
        return v, errors.New("")
    }
    if t == E_STRING {
        n := RI32(r)
        s, _ := RBytes(r, n - 1)
        if r.Pos < r.Len {
            r.Pos = r.Pos + 1
        }
        v.Str = s
        return v, errors.New("")
    }
    if t == E_DOC {
        sub, derr := Decode(r)
        if str.Len(derr.message) > 0 {
            return v, derr
        }
        v.Keys = sub.Keys
        v.Arr = sub.Arr
        return v, errors.New("")
    }
    if t == E_ARRAY {
        sub, derr := Decode(r)
        if str.Len(derr.message) > 0 {
            return v, derr
        }
        v.Arr = sub.Arr
        return v, errors.New("")
    }
    if t == E_BINARY {
        n := RI32(r)
        if r.Pos < r.Len {
            v.Subtype = int(Skink_mem_byte(r.Body, int64(r.Pos)))
            r.Pos = r.Pos + 1
        }
        s, _ := RBytes(r, n)
        v.Bytes = s
        v.Len = n
        return v, errors.New("")
    }
    if t == E_OBJECTID {
        s, _ := RBytes(r, 12)
        v.Bytes = s
        v.Len = 12
        return v, errors.New("")
    }
    if t == E_DECIMAL {
        s, _ := RBytes(r, 16)
        v.Bytes = s
        v.Len = 16
        return v, errors.New("")
    }
    if t == E_BOOL {
        if r.Pos < r.Len {
            v.Bool = Skink_mem_byte(r.Body, int64(r.Pos)) != 0
            r.Pos = r.Pos + 1
        }
        return v, errors.New("")
    }
    if t == E_DATETIME || t == E_TIMESTAMP {
        v.I64 = RI64(r)
        return v, errors.New("")
    }
    if t == E_NULL || t == E_MINKEY || t == E_MAXKEY {
        return v, errors.New("")
    }
    if t == E_REGEX {
        v.Str = RCStr(r)
        v.Options = RCStr(r)
        return v, errors.New("")
    }
    if t == E_INT32 {
        v.I64 = int64(RI32(r))
        return v, errors.New("")
    }
    if t == E_INT64 {
        v.I64 = RI64(r)
        return v, errors.New("")
    }
    // Remaining legacy types (code 0x0D, symbol 0x0E, codewscope 0x0F,
    // dbpointer 0x0C, undefined 0x06) are obsolete — fail loudly rather
    // than silently misaligning the cursor.
    return v, errors.New(str.Concat("bson: unsupported element type ",
        Itoa64(int64(t))))
}

// ---- lookups -----------------------------------------------------------------

// Get returns the element for key in a document Val.
pub fn Get(doc: Val, key: string) -> (Val, bool) {
    for i := 0; i < len(doc.Keys); i = i + 1 {
        if str.Equal(doc.Keys[i], key) {
            return doc.Arr[i], true
        }
    }
    return Val{}, false
}

// Path resolves a dotted path like "cursor.firstBatch".
pub fn Path(doc: Val, path: string) -> (Val, bool) {
    cur := doc
    start := 0
    n := str.Len(path)
    for {
        dot := n
        for i := start; i < n; i = i + 1 {
            if path[i] == 46 {
                dot = i
                break
            }
        }
        seg := str.Substr(path, start, dot - start)
        v, ok := Get(cur, seg)
        if !ok {
            return Val{}, false
        }
        if dot >= n {
            return v, true
        }
        cur = v
        start = dot + 1
    }
    return Val{}, false
}

// OkField reports whether a command reply doc has ok:1.
pub fn OkField(doc: Val) -> bool {
    v, ok := Get(doc, "ok")
    if !ok {
        return false
    }
    if v.Kind == E_DOUBLE {
        return v.Num == 1.0
    }
    return v.I64 == int64(1)
}

// ErrMsg extracts errmsg from a reply doc ("" when absent).
pub fn ErrMsg(doc: Val) -> string {
    v, ok := Get(doc, "errmsg")
    if ok && v.Kind == E_STRING {
        return v.Str
    }
    return ""
}

// Itoa64 formats an int64 (array keys, sizes).
pub fn Itoa64(v: int64) -> string {
    if v == int64(0) {
        return "0"
    }
    neg := false
    n := v
    if n < 0 {
        neg = true
        n = -n
    }
    buf := libc.malloc(24)
    i := 23
    Skink_mem_write_byte(buf, int64(i), 0)
    for n > 0 {
        i = i - 1
        Skink_mem_write_byte(buf, int64(i), 48 + int(n % int64(10)))
        n = n / int64(10)
    }
    if neg {
        i = i - 1
        Skink_mem_write_byte(buf, int64(i), 45)
    }
    return string(int64(buf) + int64(i))
}
